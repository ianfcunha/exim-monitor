# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Banco de dados local
*.db
*.sqlite3

# Dumps pré-migração escritos pelo backend (docker-compose monta ./backups)
/backups/

# Variáveis de ambiente (nunca commitar o .env real)
.env
!.env.example

# Node / frontend
node_modules/
dist/
.cache/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Artefato vazio que aparece em backend/ ao recriar o container backend
# (bind mount de ./diag-exim.sh:/app/diag-exim.sh) — não rastrear.
/backend/diag-exim.sh

# O CI copia diag-exim/ -> backend/diag-exim/ para embutir na imagem do
# backend (ver .github/workflows/docker-build.yml). Se você rodar o build
# localmente, essa cópia não deve ser rastreada.
/backend/diag-exim/
