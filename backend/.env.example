# ============================================================
# EXIM Monitor — configuracoes do backend
# Copie para .env e ajuste os valores:  cp .env.example .env
# ============================================================

# "production" recusa subir se os segredos abaixo (ADMIN_PASSWORD,
# JWT_SECRET, SSH_ENCRYPTION_KEY) ainda estiverem com o valor padrao.
# Use "development" para rodar localmente/homologacao sem trocar tudo.
ENVIRONMENT=production

# ── Conexao SSH com o servidor EXIM ─────────────────────────
SSH_HOST=seu-servidor.exemplo.com
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSWORD=             # nao recomendado; prefira chave

# Caminho do script no servidor remoto
SCRIPT_PATH=/root/diag-exim.sh

# ── Autenticacao do dashboard ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-agora

# Segredo para assinar JWT — use uma string longa e aleatoria
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GERE-UM-SEGREDO-FORTE-AQUI
JWT_EXPIRE_MINUTES=480

# ── Banco de dados PostgreSQL ────────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/banco
# Em Docker Compose o host e o nome do servico (postgres)
DATABASE_URL=postgresql://exim:TROQUE_A_SENHA@postgres:5432/exim_monitor

# ── CORS: origens permitidas ─────────────────────────────────
# Em producao, substitua pelo dominio real do frontend
CORS_ORIGINS=["http://localhost:5173"]

# ── Intervalos de coleta (segundos) ─────────────────────────
QUICK_INTERVAL=30
FULL_INTERVAL=300
