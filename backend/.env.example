# ============================================================
# Mail IQ — configuracoes do backend
# Copie para .env e ajuste:  cp .env.example .env
# O install.sh gera este arquivo automaticamente com segredos fortes —
# edite a mao so numa instalacao manual.
# ============================================================

# "production" recusa subir se os segredos abaixo ainda estiverem com o
# valor de fabrica. Use "development" para rodar local/homologacao.
ENVIRONMENT=production

# ── Autenticacao do painel ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-agora

# Assina o JWT — string longa e aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GERE-UM-SEGREDO-FORTE-AQUI
JWT_EXPIRE_MINUTES=480

# Cifra as credenciais SSH dos servidores no banco (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSH_ENCRYPTION_KEY=GERE-UMA-CHAVE-FERNET-AQUI

# ── Banco de dados PostgreSQL ────────────────────────────────
# Em Docker Compose o host e o nome do servico (postgres).
DATABASE_URL=postgresql://exim:TROQUE_A_SENHA@postgres:5432/exim_monitor

# ── CORS: origens permitidas ─────────────────────────────────
# Em producao, o dominio real do painel (com https:// se houver TLS).
CORS_ORIGINS=["http://localhost:5173"]

# ── Intervalos de coleta (segundos) ─────────────────────────
QUICK_INTERVAL=30
FULL_INTERVAL=300

# ── Servidores monitorados ───────────────────────────────────
# NAO se configura servidor Exim por aqui. Cada servidor e cadastrado
# pela interface (Servidores -> Adicionar), com sua propria chave SSH
# gerada pelo painel e guardada cifrada no banco (via SSH_ENCRYPTION_KEY).
# As variaveis SSH_HOST / SSH_USER / SSH_KEY_PATH / SCRIPT_PATH do modelo
# antigo (um unico servidor "padrao" por .env) ainda sao lidas para
# compatibilidade, mas nao sao o caminho recomendado.
