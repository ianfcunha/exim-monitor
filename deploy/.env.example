# Mail IQ — configuração do deploy. Copie para `.env` e preencha.
# O `.env` real NUNCA vai para o git nem sai desta máquina — ele guarda a
# chave que decifra as credenciais SSH dos servidores monitorados.
# Guarde uma cópia offline (o backup.sh empacota este arquivo junto).

# ── Versão ──────────────────────────────────────────────────────────────
# Tag das imagens a rodar. O upgrade.sh troca este valor; o rollback é
# voltar para a tag anterior. Não use "latest".
MAILIQ_VERSION=1.0.0

# Namespace do registry das imagens. Só mude se você espelha as imagens
# em outro registry.
MAILIQ_REGISTRY=ghcr.io/ianfcunha

# ── Domínio / acesso ────────────────────────────────────────────────────
# FQDN do painel. Aponte o DNS (registro A) para este servidor ANTES de
# subir — o Caddy emite o certificado TLS na primeira requisição.
DOMAIN=monitor.seudominio.com.br

# ── Banco de dados ──────────────────────────────────────────────────────
# Gere uma senha forte e não a troque depois (o volume do Postgres é
# inicializado com ela): openssl rand -base64 24 | tr -d '=+/'
POSTGRES_PASSWORD=

# ── Painel ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@seudominio.com.br

# Segredos do backend. Gere:
#   JWT_SECRET          openssl rand -hex 32
#   SSH_ENCRYPTION_KEY  openssl rand -base64 32 | tr '+/' '-_'
# TROCAR o SSH_ENCRYPTION_KEY depois torna todos os servidores já
# cadastrados indecifráveis — trate como a chave-mestra que é.
JWT_SECRET=
SSH_ENCRYPTION_KEY=
JWT_EXPIRE_MINUTES=480

# Origens permitidas para o frontend (o Caddy serve em https://$DOMAIN).
CORS_ORIGINS=["https://monitor.seudominio.com.br"]

# ── Licença ─────────────────────────────────────────────────────────────
# Token entregue junto com a contratação. Conferido offline (assinatura
# Ed25519) — o painel não fala com nenhum servidor de licenciamento, e
# funciona em rede fechada.
# Em branco põe a instalação em cortesia: 1 servidor por 30 dias.
# Licença vencida, inválida ou ausente NUNCA trava o painel, nem para o
# coletor dos servidores já cadastrados, nem apaga dado nenhum. A única
# consequência é recusar o cadastro de servidores NOVOS.
# Depois de alterar: docker compose up -d backend
# (up -d, não restart: o restart não relê o .env e a mudança seria ignorada)
MAILIQ_LICENSE=

# ── Coleta ──────────────────────────────────────────────────────────────
QUICK_INTERVAL=30
FULL_INTERVAL=300
